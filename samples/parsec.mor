pub module Core = file "lib/core/core.mor"

pub module Pos = file "parsec/pos.mor" with { Core }

pub module Error = file "parsec/error.mor" with { Core, Pos }

pub module Prim = file "parsec/prim.mor" with { Core, Pos, Error }

pub module Char = file "parsec/char.mor" with { Core, Pos, Error, Prim }

pub module Combinator = file "parsec/combinator.mor" with { Core, Pos, Error, Prim }

