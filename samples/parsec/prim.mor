import Core
  expose {
    module Array,
    module Iter,
    module Option,
    module Either,
    module Func,
    module Result
  }

import Pos
import Error


pub lazy(f: () -> ParsecT a): ParsecT a =
  ParsecT(\s -> unParser(f(), s))

handleCOK(a: a, s: ParseState, err: Error.ParseError): Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError) =
  Consumed(Result.Ok(a, s, err))

handleCERR(err: Error.ParseError): Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError) =
  Consumed(Result.Err(err))

handleEOK(a: a, s: ParseState, err: Error.ParseError): Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError) =
  Empty(Result.Ok(a, s, err))

handleEERR(err: Error.ParseError): Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError) =
  Empty(Result.Err(err))

unknownError(state: ParseState): Error.ParseError =
  Error.newErrorUnknown(statePos(state))

sysUnExpectError(msg: Array Byte, pos: Pos.SourcePos): Result.Result (a, ParseState, Error.ParseError) Error.ParseError =
  Result.Err(Error.newErrorMessage(Error.SysUnExpect(msg), pos))

// -- | The parser @unexpected msg@ always fails with an unexpected error
// -- message @msg@ without consuming any input.
// --
// -- The parsers 'fail', ('<?>') and @unexpected@ are the three parsers
// -- used to generate error messages. Of these, only ('<?>') is commonly
// -- used. For an example of the use of @unexpected@, see the definition
// -- of 'Text.Parsec.Combinator.notFollowedBy'.

pub unexpected(msg: Array Byte): ParsecT a =
  ParsecT(\s -> handleEERR(Error.newErrorMessage(Error.UnExpect(msg), statePos(s))))

// -- | ParserT monad transformer and Parser type

// -- | @ParsecT s u m a@ is a parser with stream type @s@, user state type @u@,
// -- underlying monad @m@ and return type @a@.  Parsec is strict in the user state.
// -- If this is undesirable, simply use a data type like @data Box a = Box a@ and
// -- the state type @Box YourStateType@ to add a level of indirection.

pub type ParsecT a {
  ParsecT(ParseState -> Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError))
}

unParser(p: ParsecT a, state: ParseState): (Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError)) =
  let ParsecT(unP) = p in unP(state)

runParsecT(p: ParsecT a, s: ParseState): Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError) =
  let cok = \(a, s1, err) -> Consumed(Result.Ok(a, s1, err)) in
  let cerr = \err -> Consumed(Result.Err(err)) in
  let eok = \(a, s1, err) -> Empty(Result.Ok(a, s1, err)) in
  let eerr = \err -> Empty(Result.Err(err)) in
  unParser(p, s)

// -- | Low-level creation of the ParsecT type. You really shouldn't have to do this.
mkPT(k: ParseState -> Consumed (Result.Result (a, ParseState, Error.ParseError) Error.ParseError)): ParsecT a =
  ParsecT(\s -> match k(s) {
    Consumed(rep) -> match rep {
        Result.Ok(x, s1, err) -> handleCOK(x, s1, err),
        Result.Err(err) -> handleCERR(err)
    },
    Empty(rep) -> match rep {
      Result.Ok(x, s1, err) -> handleEOK(x, s1, err),
      Result.Err(err) -> handleEERR(err)
    }
  })

type Consumed a {
  Consumed(a),
  Empty(a)
}

type ParseState {
  ParseState(Iter.Iter Byte, Pos.SourcePos, Int)
}

stateInput(state: ParseState): Iter.Iter Byte =
  let ParseState(s,_,_) = state in s

statePos(state: ParseState): Pos.SourcePos =
  let ParseState(_,pos,_) = state in pos

stateUser(state: ParseState): Int =
  let ParseState(_,_,u) = state in u


pub parsecMap(f: a -> b, p: ParsecT a): ParsecT b =
  ParsecT(\s -> match unParser(p, s) {
    Consumed(Result.Ok(a, s1, err)) -> Consumed(Result.Ok(f(a), s1, err)),
    Consumed(Result.Err(err)) -> Consumed(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> Empty(Result.Ok(f(a), s1, err)),
    Empty(Result.Err(err)) -> Empty(Result.Err(err)),
  })

pub parserReturn(x: a): ParsecT a =
  ParsecT(\s -> handleEOK(x, s, unknownError(s)))

pub parserBind(m: ParsecT a, k: a -> ParsecT b): ParsecT b =
  ParsecT(\s -> match unParser(m, s) {
    Consumed(Result.Ok(a, s1, err))-> if Error.errorIsUnknown(err) {
      match unParser(k(a), s1) {
        Consumed(Result.Ok(a1, s2, err1)) -> Consumed(Result.Ok(a1, s2, err1)),
        Consumed(Result.Err(err1)) -> Consumed(Result.Err(err1)),
        Empty(Result.Ok(a1, s2, err1)) -> Consumed(Result.Ok(a1, s2, err1)),
        Empty(Result.Err(err1)) -> Consumed(Result.Err(err1))
      }
    } else {
      match unParser(k(a), s1) {
        Consumed(Result.Ok(a1, s2, err1)) -> Consumed(Result.Ok(a1, s2, err1)),
        Consumed(Result.Err(err1)) -> Consumed(Result.Err(err1)),
        Empty(Result.Ok(a1, s2, err1)) -> Consumed(Result.Ok(a1, s2, Error.mergeError(err, err1))),
        Empty(Result.Err(err1)) -> Consumed(Result.Err(Error.mergeError(err, err1)))
      }
    },
    Consumed(Result.Err(err)) -> Consumed(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> if Error.errorIsUnknown(err) {
      unParser(k(a), s1)
    } else {
      match unParser(k(a), s1) {
        Consumed(Result.Ok(a1, s2, err1)) -> Consumed(Result.Ok(a1, s2, err1)),
        Consumed(Result.Err(err1)) -> Consumed(Result.Err(err1)),
        Empty(Result.Ok(a1, s2, err1)) -> Empty(Result.Ok(a1, s2, Error.mergeError(err, err1))),
        Empty(Result.Err(err1)) -> Empty(Result.Err(Error.mergeError(err, err1)))
      }
    },
    Empty(Result.Err(err)) -> Empty(Result.Err(err))
  })

pub parserSequence(ps: Array (ParsecT a)): ParsecT (Array a) =
  parserSequenceI(Iter.items(ps))

parserSequenceI(ps: Iter.Iter (ParsecT a)): ParsecT (Array a) =
  match Iter.next(ps) {
    Option.None -> parserReturn([]),
    Option.Some(p, ps1) -> parserBind(p, \x -> parsecMap(\xs1 -> Array.push(xs1, x), parserSequenceI(ps1)))
  }


mergeErrorReply(err1: Error.ParseError, reply: Result.Result (a, ParseState, Error.ParseError) Error.ParseError): Result.Result (a, ParseState, Error.ParseError) Error.ParseError =
  match reply {
    Result.Ok(x, state, err2) -> Result.Ok(x, state, Error.mergeError(err1, err2)),
    Result.Err(err2) -> Result.Err(Error.mergeError(err1, err2))
  }

pub parserFail(msg: Array Byte): ParsecT a =
  ParsecT(\s -> handleEERR(Error.newErrorMessage(Error.Message(msg), statePos(s))))


// -- | @parserZero@ always fails without consuming any input. @parserZero@ is defined
// -- equal to the 'mzero' member of the 'MonadPlus' class and to the 'Control.Applicative.empty' member
// -- of the 'Control.Applicative.Alternative' class.

pub parserZero: ParsecT a =
  ParsecT(\s -> handleEERR(unknownError(s)))

parserPlus(m: ParsecT a, n: ParsecT a): ParsecT a =
  ParsecT(\s -> match unParser(m, s) {
    Consumed(Result.Ok(a, s1, err)) -> Consumed(Result.Ok(a, s1, err)),
    Consumed(Result.Err(err)) -> Consumed(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> Empty(Result.Ok(a, s1, err)),
    Empty(Result.Err(err)) -> match unParser(n, s) {
      Consumed(Result.Ok(a, s1, err1)) -> Consumed(Result.Ok(a, s1, err1)),
      Consumed(Result.Err(err1)) -> Consumed(Result.Err(err1)),
      Empty(Result.Ok(a, s1, err1)) -> Empty(Result.Ok(a, s1, Error.mergeError(err, err1))),
      Empty(Result.Err(err1)) -> Empty(Result.Err(Error.mergeError(err, err1)))
    }
  })

// -- | The parser @p \<?> msg@ behaves as parser @p@, but whenever the
// -- parser @p@ fails /without consuming any input/, it replaces expect
// -- error messages with the expect error message @msg@.
// --
// -- This is normally used at the end of a set alternatives where we want
// -- to return an error message in terms of a higher level construct
// -- rather than returning all possible characters. For example, if the
// -- @expr@ parser from the 'try' example would fail, the error
// -- message is: '...: expecting expression'. Without the @(\<?>)@
// -- combinator, the message would be like '...: expecting \"let\" or
// -- letter', which is less friendly.

// withErr is <?>
pub withErr(p: ParsecT a, msg: Array Byte): ParsecT a =
  label(p, msg)

// -- | This combinator implements choice. The parser @p \<|> q@ first
// -- applies @p@. If it succeeds, the value of @p@ is returned. If @p@
// -- fails /without consuming any input/, parser @q@ is tried. This
// -- combinator is defined equal to the 'mplus' member of the 'MonadPlus'
// -- class and the ('Control.Applicative.<|>') member of 'Control.Applicative.Alternative'.
// --
// -- The parser is called /predictive/ since @q@ is only tried when
// -- parser @p@ didn't consume any input (i.e.. the look ahead is 1).
// -- This non-backtracking behaviour allows for both an efficient
// -- implementation of the parser combinators and the generation of good
// -- error messages.

// tryOr is <|>
pub tryOr(p1: ParsecT a, p2: ParsecT a): ParsecT a =
  parserPlus(p1, p2)

// -- | A synonym for @\<?>@, but as a function instead of an operator.
label(p: ParsecT a, msg: Array Byte): ParsecT a =
  labels(p, [msg])

labels(p: ParsecT a, msgs: Array (Array Byte)): ParsecT a =
  let setExpectErrors = \(err, msgs1) ->
    let msgsI = Iter.items(msgs1) in
    match Iter.next(msgsI) {
      Option.None -> Error.setErrorMessage(Error.Expect([]), err),
      Option.Some(msg, msgsI1) -> if Iter.count(msgsI1) = 0 {
        Error.setErrorMessage(Error.Expect(msg), err)
      } else {
        Iter.foldr(msgsI1, Error.setErrorMessage(Error.Expect(msg), err), \(msg1, err1) -> Error.addErrorMessage(Error.Expect(msg1), err1))
      }
    } in
  ParsecT(\s -> match unParser(p, s) {
    Consumed(Result.Ok(a, s1, err)) -> Consumed(Result.Ok(a, s1, err)),
    Consumed(Result.Err(err)) -> Consumed(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> if Error.errorIsUnknown(err) {
      Empty(Result.Ok(a, s1, err))
    } else {
      Empty(Result.Ok(a, s1, setExpectErrors(err, msgs)))
    },
    Empty(Result.Err(err)) -> Empty(Result.Err(setExpectErrors(err, msgs)))
  })


pub tokens(eqT: (Byte, Byte) -> Bool, showTokens: Iter.Iter Byte -> Array Byte, nextposs: (Pos.SourcePos, Iter.Iter Byte) -> Pos.SourcePos, tts: Iter.Iter Byte): ParsecT (Array Byte) =
  match Iter.next(tts) {
    Option.None -> ParsecT(\s -> handleEOK([], s, unknownError(s))),
    Option.Some(tok, toks) ->
      ParsecT(\s ->
        let ParseState(input, pos, u) = s in
        let errEof = Error.setErrorMessage(Error.Expect(showTokens(tts)), Error.newErrorMessage(Error.SysUnExpect(""), pos)) in
        let errExpect = \x -> Error.setErrorMessage(Error.Expect(showTokens(tts)), Error.newErrorMessage(Error.SysUnExpect([x]), pos)) in
        match uncons(input) {
          Option.None -> handleEERR(errEof),
          Option.Some(x, xs) -> if eqT(tok, x) {
            walk(toks, xs, u, tts, pos, nextposs, errEof, errExpect)
          } else {
            handleEERR(errExpect(x))
          }
        })
  }

walk(ts1: Iter.Iter Byte, rs: Iter.Iter Byte, u: Int, tts: Iter.Iter Byte, pos: Pos.SourcePos, nextposs: (Pos.SourcePos, Iter.Iter Byte) -> Pos.SourcePos, errEof: Error.ParseError, errExpect: Byte -> Error.ParseError): Consumed (Result.Result (Array Byte, ParseState, Error.ParseError) Error.ParseError) =
  let ok = \rs1 ->
    let pos1 = nextposs(pos, tts) in
    let s1 = ParseState(rs, pos1, u) in
    handleCOK(Array.from_iter(tts), s1, Error.newErrorUnknown(pos1)) in
  match Iter.next(ts1) {
    Option.None -> ok(rs),
    Option.Some(t, ts) -> match uncons(rs) {
      Option.None -> handleCERR(errEof),
      Option.Some(x, xs) -> if t =& x {
        walk(ts, xs, u, tts, pos, nextposs, errEof, errExpect)
      } else {
        handleCERR(errExpect(x))
      }
    }
  }


uncons(cs: Iter.Iter Byte): Option.Option (Byte, Iter.Iter Byte) = Iter.next(cs)

// -- | Like 'tokens', but doesn't consume matching prefix.
pub tokens1(showTokens: Iter.Iter Byte -> Array Byte, nextposs: (Pos.SourcePos, Iter.Iter Byte) -> Pos.SourcePos, tts: Iter.Iter Byte): ParsecT (Array Byte) =
  match Iter.next(tts) {
    Option.None -> ParsecT(\s -> handleEOK([], s, unknownError(s))),
    Option.Some(tok, toks) ->
      ParsecT(\s ->
        let ParseState(input, pos, u) = s in
        let errEof = Error.setErrorMessage(Error.Expect(showTokens(tts)), Error.newErrorMessage(Error.SysUnExpect(""), pos)) in
        let errExpect = \x -> Error.setErrorMessage(Error.Expect(showTokens(tts)), Error.newErrorMessage(Error.SysUnExpect([x]), pos)) in
        match uncons(input) {
          Option.None -> handleEERR(errEof),
          Option.Some(x, xs) -> if tok =& x {
            walk(toks, xs, u, tts, pos, nextposs, errEof, errExpect)
          } else {
            handleEERR(errExpect(x))
          }
        })
    }

// -- | The parser @try p@ behaves like parser @p@, except that it
// -- pretends that it hasn'Byte consumed any input when an error occurs.
// --
// -- This combinator is used whenever arbitrary look ahead is needed.
// -- Since it pretends that it hasn't consumed any input when @p@ fails,
// -- the ('<|>') combinator will try its second alternative even when the
// -- first parser failed while consuming input.
// --
// -- The @try@ combinator can for example be used to distinguish
// -- identifiers and reserved words. Both reserved words and identifiers
// -- are a sequence of letters. Whenever we expect a certain reserved
// -- word where we can also expect an identifier we have to use the @try@
// -- combinator. Suppose we write:
// --
// -- >  expr        = letExpr <|> identifier <?> "expression"
// -- >
// -- >  letExpr     = do{ string "let"; ... }
// -- >  identifier  = many1 letter
// --
// -- If the user writes \"lexical\", the parser fails with: @unexpected
// -- \'x\', expecting \'t\' in \"let\"@. Indeed, since the ('<|>') combinator
// -- only tries alternatives when the first alternative hasn't consumed
// -- input, the @identifier@ parser is never tried (because the prefix
// -- \"le\" of the @string \"let\"@ parser is already consumed). The
// -- right behaviour can be obtained by adding the @try@ combinator:
// --
// -- >  expr        = letExpr <|> identifier <?> "expression"
// -- >
// -- >  letExpr     = do{ try (string "let"); ... }
// -- >  identifier  = many1 letter

pub try(p: ParsecT a): ParsecT a =
  // ParsecT(\(s, cok, _, eok, eerr) -> unParser(p, s, cok, eerr, eok, eerr))
  ParsecT(\s -> match unParser(p, s) {
    Consumed(Result.Ok(a, s1, err)) -> Consumed(Result.Ok(a, s1, err)),
    Consumed(Result.Err(err)) -> Empty(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> Empty(Result.Ok(a, s1, err)),
    Empty(Result.Err(err)) -> Empty(Result.Err(err))
  })

// -- | @lookAhead p@ parses @p@ without consuming any input.
// --
// -- If @p@ fails and consumes some input, so does @lookAhead@. Combine with 'try'
// -- if this is undesirable.

lookAhead(p: ParsecT a): ParsecT a =
  ParsecT(\s -> match unParser(p, s) {
    Consumed(Result.Ok(a, s1, err)) -> Empty(Result.Ok(a, s, Error.newErrorUnknown(statePos(s)))),
    Consumed(Result.Err(err)) -> Consumed(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> Empty(Result.Ok(a, s, Error.newErrorUnknown(statePos(s)))),
    Empty(Result.Err(err)) -> Empty(Result.Err(err))
  })

// -- | The parser @token showTok posFromTok testTok@ accepts a token @t@
// -- with result @x@ when the function @testTok t@ returns @'Just' x@. The
// -- source position of the @t@ should be returned by @posFromTok t@ and
// -- the token can be shown using @showTok t@.
// --
// -- This combinator is expressed in terms of 'tokenPrim'.
// -- It is used to accept user defined token streams. For example,
// -- suppose that we have a stream of basic tokens tupled with source
// -- positions. We can then define a parser that accepts single tokens as:
// --
// -- >  mytoken x
// -- >    = token showTok posFromTok testTok
// -- >    where
// -- >      showTok (pos,t)     = show t
// -- >      posFromTok (pos,t)  = pos
// -- >      testTok (pos,t)     = if x == t then Just t else Nothing

token(showToken: Byte -> Array Byte, tokpos: Byte -> Pos.SourcePos, test: Byte -> Option.Option a): ParsecT a =
  let nextpos = \(_,tok, ts) -> match uncons(ts) {
    Option.None -> tokpos(tok),
    Option.Some(tok1,_) -> tokpos(tok1)
  } in
  tokenPrim(showToken, nextpos, test)

// -- | The parser @tokenPrim showTok nextPos testTok@ accepts a token @t@
// -- with result @x@ when the function @testTok t@ returns @'Just' x@. The
// -- token can be shown using @showTok t@. The position of the /next/
// -- token should be returned when @nextPos@ is called with the current
// -- source position @pos@, the current token @t@ and the rest of the
// -- tokens @toks@, @nextPos pos t toks@.
// --
// -- This is the most primitive combinator for accepting tokens. For
// -- example, the 'Text.Parsec.Char.char' parser could be implemented as:
// --
// -- >  char c
// -- >    = tokenPrim showChar nextPos testChar
// -- >    where
// -- >      showChar x        = "'" ++ x ++ "'"
// -- >      testChar x        = if x == c then Just x else Nothing
// -- >      nextPos pos x xs  = updatePosChar pos x


pub tokenPrim(showToken: Byte -> Array Byte, nextpos: (Pos.SourcePos, Byte, Iter.Iter Byte) -> Pos.SourcePos, test: Byte -> Option.Option a): ParsecT a =
  tokenPrimEx(showToken, nextpos, Option.None, test)

tokenPrimEx(showToken: Byte -> Array Byte, nextpos: (Pos.SourcePos, Byte, Iter.Iter Byte) -> Pos.SourcePos, nextStateM: Option.Option ((Pos.SourcePos, Byte, Iter.Iter Byte, Int) -> Int), test: Byte -> Option.Option a): ParsecT a =
  match nextStateM {
    Option.None -> ParsecT(\state ->
      let ParseState(input, pos, user) = state in
      match uncons(input) {
        Option.None -> handleEERR(unexpectError("", pos)),
        Option.Some(c, cs) -> match test(c) {
          Option.Some(x) ->
            let newpos = nextpos(pos, c, cs) in
            let newstate = ParseState(cs, newpos, user) in
            handleCOK(x, newstate, Error.newErrorUnknown(newpos)),
          Option.None -> handleEERR(unexpectError(showToken(c), pos))
        }
      }),
    Option.Some(nextState) -> ParsecT(\state ->
      let ParseState(input, pos, user) = state in
      match uncons(input) {
        Option.None -> handleEERR(unexpectError("", pos)),
        Option.Some(c, cs) -> match test(c) {
          Option.Some(x) ->
            let newpos = nextpos(pos, c, cs) in
            let newUser = nextState(pos, c, cs, user) in
            let newstate = ParseState(cs, newpos, newUser) in
            handleCOK(x, newstate, Error.newErrorUnknown(newpos)),
          Option.None -> handleEERR(unexpectError(showToken(c), pos))
        }
      })
  }

unexpectError(msg: Array Byte, pos: Pos.SourcePos): Error.ParseError =
  Error.newErrorMessage(Error.SysUnExpect(msg), pos)


// -- | @many p@ applies the parser @p@ /zero/ or more times. Returns a
// --    list of the returned values of @p@.
// --
// -- >  identifier  = do{ c  <- letter
// -- >                  ; cs <- many (alphaNum <|> char '_')
// -- >                  ; return (c:cs)
// -- >                  }

pub many(p: ParsecT a): ParsecT (Array a) =
  manyAccum(\(x, xs) -> Array.push(xs, x), p)

// -- | @many1 p@ applies the parser @p@ /one/ or more times. Returns a
// -- list of the returned values of @p@.
// --
// -- >  word  = many1 letter

// {-# INLINABLE many1 #-}
pub many1(p: ParsecT a): ParsecT (Array a) =
  parserBind(p, \x -> parserBind(many(p), \xs -> parserReturn(Array.push_front(x, xs))))

// -- | @skipMany p@ applies the parser @p@ /zero/ or more times, skipping
// -- its result.
// --
// -- >  spaces  = skipMany space

pub skipMany(p: ParsecT a): ParsecT () =
  parsecMap(\_ -> (), manyAccum(\(_,_) -> [], p))

manyAccum(acc: (a, Array a) -> Array a, p: ParsecT a): ParsecT (Array a) =
  ParsecT(\s -> match unParser(p, s) {
    Consumed(Result.Ok(a, s1, err)) -> walk1([], a, s1, acc, p),
    Consumed(Result.Err(err)) -> Consumed(Result.Err(err)),
    Empty(Result.Ok(a, s1, err)) -> panic("Text.ParserCombinators.Parsec.Prim.many: combinator 'many' is applied to a parser that accepts an empty string."),
    Empty(Result.Err(err)) -> Empty(Result.Ok([], s, err))
  })

walk1(accum: Array a, a: a, s: ParseState, acc: (a, Array a) -> Array a, p: ParsecT a): Consumed (Result.Result (Array a, ParseState, Error.ParseError) Error.ParseError) =
  match unParser(p, s) {
    Consumed(Result.Ok(a1, s1, _)) -> walk1(acc(a, accum), a1, s1, acc, p),
    Consumed(Result.Err(err)) -> handleCERR(err),
    Empty(Result.Ok(a1, s1, _)) -> panic("Text.ParserCombinators.Parsec.Prim.many: combinator 'many' is applied to a parser that accepts an empty string."),
    Empty(Result.Err(err)) -> handleCOK(acc(a, accum), s, err)
  }


// -- < Running a parser: monadic (runPT) and pure (runP)

runPT(p: ParsecT a, u: Int, name: Array Byte, s: Iter.Iter Byte): Either.BadGood Error.ParseError a =
  match parserReply(runParsecT(p, ParseState(s, Pos.initialPos(name), u))) {
    Result.Ok(x,_,_) -> Either.Good(x),
    Result.Err(err) -> Either.Bad(err)
  }

parserReply(res: Consumed a): a =
  match res {
    Consumed(r) -> r,
    Empty(r) -> r
  }

runP(p: ParsecT a, u: Int, name: Array Byte, s: Iter.Iter Byte): Either.BadGood Error.ParseError a =
  runPT(p, u, name, s)


// -- | The most general way to run a parser. @runParserT p state filePath
// -- input@ runs parser @p@ on the input list of tokens @input@,
// -- obtained from source @filePath@ with the initial user state @st@.
// -- The @filePath@ is only used in error messages and may be the empty
// -- string. Returns a computation in the underlying monad @m@ that return either a 'ParseError' ('Left') or a
// -- value of type @a@ ('Right').

runParserT(p: ParsecT a, u: Int, name: Array Byte, s: Iter.Iter Byte): Either.BadGood Error.ParseError a =
  runPT(p, u, name, s)

// -- | The most general way to run a parser over the Identity monad. @runParser p state filePath
// -- input@ runs parser @p@ on the input list of tokens @input@,
// -- obtained from source @filePath@ with the initial user state @st@.
// -- The @filePath@ is only used in error messages and may be the empty
// -- string. Returns either a 'ParseError' ('Left') or a
// -- value of type @a@ ('Right').
// --
// -- >  parseFromFile p fname
// -- >    = do{ input <- readFile fname
// -- >        ; return (runParser p () fname input)
// -- >        }

runParser(p: ParsecT a, u: Int, name: Array Byte, s: Iter.Iter Byte): Either.BadGood Error.ParseError a =
  runP(p, u, name, s)

// -- | @parse p filePath input@ runs a parser @p@ over Identity without user
// -- state. The @filePath@ is only used in error messages and may be the
// -- empty string. Returns either a 'ParseError' ('Left')
// -- or a value of type @a@ ('Right').
// --
// -- >  main    = case (parse numbers "" "11, 2, 43") of
// -- >             Left err  -> print err
// -- >             Right xs  -> print (sum xs)
// -- >
// -- >  numbers = commaSep integer

pub parse(p: ParsecT a, name: Array Byte, s: Iter.Iter Byte): Either.BadGood Error.ParseError a =
  runP(p, 0, name, s)

// -- < Parser state combinators

// -- | Returns the current source position. See also 'SourcePos'.

getPosition: ParsecT Pos.SourcePos =
  parsecMap(statePos, getParserState)


// -- | Returns the current input

getInput: ParsecT (Iter.Iter Byte) =
  parsecMap(stateInput, getParserState)

// -- | @setPosition pos@ sets the current source position to @pos@.

setPosition(pos: Pos.SourcePos): ParsecT () =
  parsecMap(\_ -> (), updateParserState(\state ->
    let ParseState(input,_,user) = state in
    ParseState(input, pos, user)))

// -- | @setInput input@ continues parsing with @input@. The 'getInput' and
// -- @setInput@ functions can for example be used to deal with #include
// -- files.

setInput(input: Iter.Iter Byte): ParsecT () =
  parsecMap(\_ -> (), updateParserState(\state ->
    let ParseState(_,pos,user) = state in
    ParseState(input, pos, user)))

// -- | Returns the full parser state as a 'State' record.

getParserState: ParsecT (ParseState) =
  updateParserState(Func.id)

// -- | @setParserState st@ set the full parser state to @st@.

setParserState(st: ParseState): ParsecT ParseState =
  updateParserState(\_ -> st)

// -- | @updateParserState f@ applies function @f@ to the parser state.

updateParserState(f: ParseState -> ParseState): ParsecT ParseState =
  ParsecT(\s ->
    let s1 = f(s) in
    handleEOK(s1, s1, unknownError(s1)))

// -- < User state combinators

// -- | Returns the current user state.

getState: ParsecT Int =
  parsecMap(stateUser, getParserState)

// -- | @putState st@ set the user state to @st@.

putState(u: Int): ParsecT () =
  parsecMap(\_ -> (), updateParserState(\state ->
    let ParseState(input, pos, user) = state in
    ParseState(input, pos, u)))

// -- | @modifyState f@ applies function @f@ to the user state. Suppose
// -- that we want to count identifiers in a source, we could use the user
// -- state as:
// --
// -- >  expr  = do{ x <- identifier
// -- >            ; modifyState (+1)
// -- >            ; return (Id x)
// -- >            }

modifyState(f: Int -> Int): ParsecT () =
  parsecMap(\_ -> (), updateParserState(\state ->
    let ParseState(input, pos, user) = state in
    ParseState(input, pos, f(user))))

// -- | An alias for putState for backwards compatibility.

setState(u: Int): ParsecT () =
  putState(u)

// -- | An alias for modifyState for backwards compatibility.

updateState(u: Int -> Int): ParsecT () =
  modifyState(u)