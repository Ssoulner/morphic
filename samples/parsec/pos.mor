import Core
  expose {
    module Iter,
    module Math
  }

// pub type SourceName = String
// pub type Line = Int
// pub type Column = Int

// proc main(): () = do output(Array.concat("Hello, ", "world!"))

pub type SourcePos {
  pub SourcePos (Array Byte, Int, Int)
}
  // deriving ( Eq, Ord, Data, Typeable)

newPos(name: Array Byte, line: Int, column: Int): SourcePos = SourcePos(name, line, column)

pub initialPos(name: Array Byte): SourcePos = newPos(name, 1, 1)


// Extracts the name of the source from a source position.

// sourceName :: SourcePos -> Array Byte
// sourceName (SourcePos name _line _column) = name
sourceName(sourcePos: SourcePos): Array Byte =
  let SourcePos(name, _, _) = sourcePos in name

// -- | Extracts the line number from a source position.

// sourceLine :: SourcePos -> Line
// sourceLine (SourcePos _name line _column) = line
sourceLine(sourcePos: SourcePos) : Int =
  let SourcePos(_,line,_) = sourcePos in line

// -- | Extracts the column number from a source position.

// sourceColumn :: SourcePos -> Column
// sourceColumn (SourcePos _name _line column) = column
sourceColumn(sourcePos: SourcePos): Int =
  let SourcePos(_,_,column) = sourcePos in column

// -- | Increments the line number of a source position.

// incSourceLine :: SourcePos -> Line -> SourcePos
// incSourceLine (SourcePos name line column) n = SourcePos name (line+n) column
incSourceLine(sourcePos: SourcePos, n: Int): SourcePos =
  let SourcePos(name, line, column) = sourcePos in SourcePos(name, line + n, column)

// -- | Increments the column number of a source position.

// incSourceColumn :: SourcePos -> Column -> SourcePos
// incSourceColumn (SourcePos name line column) n = SourcePos name line (column+n)
incSourceColumn(sourcePos: SourcePos, n: Int): SourcePos =
  let SourcePos(name, line, column) = sourcePos in SourcePos(name, line, column + n)

// -- | Set the name of the source.

// setSourceName :: SourcePos -> SourceName -> SourcePos
// setSourceName (SourcePos _name line column) n = SourcePos n line column
setSourceName(sourcePos: SourcePos, n: Array Byte): SourcePos =
  let SourcePos(_, line, column) = sourcePos in SourcePos(n, line, column)

// -- | Set the line number of a source position.

// setSourceLine :: SourcePos -> Line -> SourcePos
// setSourceLine (SourcePos name _line column) n = SourcePos name n column
setSourceLine(sourcePos: SourcePos, n: Int): SourcePos =
  let SourcePos(name, _, column) = sourcePos in SourcePos(name, n, column)

// -- | Set the column number of a source position.

// setSourceColumn :: SourcePos -> Column -> SourcePos
// setSourceColumn (SourcePos name line _column) n = SourcePos name line n
setSourceColumn(sourcePos: SourcePos, n: Int): SourcePos =
  let SourcePos(name, line, _) = sourcePos in SourcePos(name, line, n)

// -- | The expression @updatePosString pos s@ updates the source position
// -- @pos@ by calling 'updatePosChar' on every character in @s@, ie.
// -- @foldl updatePosChar pos string@.

// updatePosString :: SourcePos -> String -> SourcePos
// updatePosString pos string
//     = foldl updatePosChar pos string
pub updatePosString(sourcePos: SourcePos, txt: Array Byte): SourcePos =
  let inp = Iter.items(txt) in Iter.foldl(inp, sourcePos, updatePosChar)

// -- | Update a source position given a character. If the character is a
// -- newline (\'\\n\') or carriage return (\'\\r\') the line number is
// -- incremented by 1. If the character is a tab (\'\t\') the column
// -- number is incremented to the nearest 8'th column, ie. @column + 8 -
// -- ((column-1) \`mod\` 8)@. In all other cases, the column is
// -- incremented by 1.

// updatePosChar   :: SourcePos -> Char -> SourcePos
// updatePosChar (SourcePos name line column) c
//     = case c of
//         '\n' -> SourcePos name (line+1) 1
//         '\t' -> SourcePos name line (column + 8 - ((column-1) `mod` 8))
//         _    -> SourcePos name line (column + 1)
pub updatePosChar(sourcePos: SourcePos, c: Byte): SourcePos =
  let SourcePos(name, line, column) = sourcePos in
  match c {
    10b -> SourcePos(name, line + 1, 1), // \n
    09b -> SourcePos(name, line, column + 8 - (Math.mod(column - 1, 8))), // \t
    _ -> SourcePos(name, line, column + 1),
  }

