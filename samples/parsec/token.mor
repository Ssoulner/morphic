//   let TokenParser(_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,x,_,_,_,_,_,_,_,_,_,_,_,_,_) = gtp in x

pub parens(gtp: GenTokenParser a, p: Prim.ParsecT a): Prim.ParsecT a =
  let TokenParser(_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,_,x,_,_,_,_,_,_,_,_,_,_,_,_) = gtp in x(p)

