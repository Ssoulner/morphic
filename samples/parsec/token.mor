// -----------------------------------------------------------
// -- Given a LanguageDef, create a token parser.
// -----------------------------------------------------------

// -- | The expression @makeTokenParser language@ creates a 'GenTokenParser'
// -- record that contains lexical parsers that are
// -- defined using the definitions in the @language@ record.
// --
// -- The use of this function is quite stylized - one imports the
// -- appropriate language definition and selects the lexical parsers that
// -- are needed from the resulting 'GenTokenParser'.
// --
// -- >  module Main where
// -- >
// -- >  import Text.Parsec
// -- >  import qualified Text.Parsec.Token as P
// -- >  import Text.Parsec.Language (haskellDef)
// -- >
// -- >  -- The parser
// -- >  ...
// -- >
// -- >  expr  =   parens expr
// -- >        <|> identifier
// -- >        <|> ...
// -- >
// -- >
// -- >  -- The lexer
// -- >  lexer       = P.makeTokenParser haskellDef
// -- >
// -- >  parens      = P.parens lexer
// -- >  braces      = P.braces lexer
// -- >  identifier  = P.identifier lexer
// -- >  reserved    = P.reserved lexer
// -- >  ...

// makeTokenParser :: (Stream s m Char)
//                 => GenLanguageDef s u m -> GenTokenParser s u m
// {-# INLINABLE makeTokenParser #-}
// makeTokenParser languageDef
//     = TokenParser{ identifier = identifier
//                  , reserved = reserved
//                  , operator = operator
//                  , reservedOp = reservedOp

//                  , charLiteral = charLiteral
//                  , stringLiteral = stringLiteral
//                  , natural = natural
//                  , integer = integer
//                  , float = float
//                  , naturalOrFloat = naturalOrFloat
//                  , decimal = decimal
//                  , hexadecimal = hexadecimal
//                  , octal = octal

//                  , symbol = symbol
//                  , lexeme = lexeme
//                  , whiteSpace = whiteSpace

//                  , parens = parens
//                  , braces = braces
//                  , angles = angles
//                  , brackets = brackets
//                  , squares = brackets
//                  , semi = semi
//                  , comma = comma
//                  , colon = colon
//                  , dot = dot
//                  , semiSep = semiSep
//                  , semiSep1 = semiSep1
//                  , commaSep = commaSep
//                  , commaSep1 = commaSep1
//                  }
//     where

//     -----------------------------------------------------------
//     -- Bracketing
//     -----------------------------------------------------------
//     parens p        = between (symbol "(") (symbol ")") p
//     braces p        = between (symbol "{") (symbol "}") p
//     angles p        = between (symbol "<") (symbol ">") p
//     brackets p      = between (symbol "[") (symbol "]") p

//     semi            = symbol ";"
//     comma           = symbol ","
//     dot             = symbol "."
//     colon           = symbol ":"

//     commaSep p      = sepBy p comma
//     semiSep p       = sepBy p semi

//     commaSep1 p     = sepBy1 p comma
//     semiSep1 p      = sepBy1 p semi

makeTokenParser(ld: GenLanguageDef): GenTokenParser a =
  let parens = \p -> Combinator.between(symbol(ld, [40b]), symbol(ld, [41b]), p) in
  let braces = \p -> Combinator.between(symbol(ld, [123b]), symbol(ld, [125b]), p) in
  let angles = \p -> Combinator.between(symbol(ld, [60b]), symbol(ld, [62b]), p) in
  let brackets = \p -> Combinator.between(symbol(ld, [91b]), symbol(ld, [93b]), p) in
  let semi = symbol(ld, [59b]) in
  let comma = symbol(ld, [44b]) in
  let colon = symbol(ld, [58b]) in
  let dot = symbol(ld, [46b]) in
  TokenParser(identifier(ld),
              \name -> reserved(ld, name),
              operator(ld),
              \name -> reservedOp(ld, name),
              charLiteral(ld),
              stringLiteral,
              natural(ld),
              integer(ld),
              float(ld),
              naturalOrFloat(ld),
              decimal,
              hexadecimal,
              octal,
              \name -> symbol(ld, name),
              \p -> lexeme(ld, p),
              whiteSpace(ld),
              \p -> parens(p),
              \p -> braces(p),
              \p -> angles(p),
              \p -> brackets(p),
              \p -> brackets(p),
              semi,
              comma,
              colon,
              dot,
              \p -> Combinator.sepBy(p, semi),
              \p -> Combinator.sepBy1(p, semi),
              \p -> Combinator.sepBy(p, comma),
              \p -> Combinator.sepBy1(p, comma)
              )

//     -----------------------------------------------------------
//     -- Chars & Strings
//     -----------------------------------------------------------
//     charLiteral     = lexeme (between (char '\'')
//                                       (char '\'' <?> "end of character")
//                                       characterChar )
//                     <?> "character"
charLiteral(ld: GenLanguageDef): Prim.ParsecT Byte =
  Prim.withErr(lexeme(ld, Combinator.between(Char.char(39b), Prim.withErr(Char.char(39b), "end of character"), characterChar)), "character")

//     characterChar   = charLetter <|> charEscape
//                     <?> "literal character"
characterChar: Prim.ParsecT Byte =
  Prim.withErr(Prim.tryOr(charLetter, charEscape), "literal character")

//     charEscape      = do{ _ <- char '\\'; escapeCode }
charEscape: Prim.ParsecT Byte =
  Prim.parserBind(Char.char(92b), \_ -> escapeCode)
//     charLetter      = satisfy (\c -> (c /= '\'') && (c /= '\\') && (c > '\026'))
charLetter: Prim.ParsecT Byte =
  Char.satisfy(\c -> !(c =& 39b) && !(c =& 92b) && panic("What is 026 here?"))



//     stringLiteral   = lexeme (
//                       do{ str <- between (char '"')
//                                          (char '"' <?> "end of string")
//                                          (many stringChar)
//                         ; return (foldr (maybe id (:)) "" str)
//                         }
//                       <?> "literal string")
stringLiteral: Prim.ParsecT (Array Byte) =
  panic("not implemented")
  // lexeme(Prim.parserBind(Combinator.between(Char.char(34b), Prim.withErr(Char.char(34b), "end of string"), Prim.many(stringChar)), Prim.parserReturn(??)))

//     stringChar      =   do{ c <- stringLetter; return (Just c) }
//                     <|> stringEscape
//                     <?> "string character"
stringChar: Prim.ParsecT (Option.Option Byte) =
  Prim.withErr(Prim.tryOr(Prim.parserBind(stringLetter, \c -> Prim.parserReturn(Option.Some(c))), stringEscape), "literal string")

//     stringLetter    = satisfy (\c -> (c /= '"') && (c /= '\\') && (c > '\026'))
stringLetter: Prim.ParsecT Byte =
  Char.satisfy(\c -> !(c =& 34b) && !(c =& 92b) && (c >& 26b))

//     stringEscape    = do{ _ <- char '\\'
//                         ;     do{ _ <- escapeGap  ; return Nothing }
//                           <|> do{ _ <- escapeEmpty; return Nothing }
//                           <|> do{ esc <- escapeCode; return (Just esc) }
//                         }
stringEscape: Prim.ParsecT (Option.Option Byte) =
  Prim.tryOr(Prim.tryOr(Prim.parserBind(Char.char(92b), \_ -> Prim.parserBind(escapeGap, \_ -> Prim.parserReturn(Option.None))), Prim.parserBind(escapeEmpty, \_ -> Prim.parserReturn(Option.None))), Prim.parserBind(escapeCode, \esc -> Prim.parserReturn(Option.Some(esc))))

//     escapeEmpty     = char '&'
escapeEmpty: Prim.ParsecT Byte =
  Char.char(38b)
//     escapeGap       = do{ _ <- many1 space
//                         ; char '\\' <?> "end of string gap"
//                         }
escapeGap: Prim.ParsecT Byte =
  Prim.parserBind(Prim.many1(Char.space), \_ -> Prim.withErr(Char.char(92b), "end of string gap"))



//     -- escape codes
//     escapeCode      = charEsc <|> charNum <|> charAscii <|> charControl
//                     <?> "escape code"
escapeCode: Prim.ParsecT Byte =
  Prim.withErr(Prim.tryOr(charEsc, Prim.tryOr(charNum, Prim.tryOr(charAscii, charControl))), "escape code")

//     charControl     = do{ _ <- char '^'
//                         ; code <- upper
//                         ; return (toEnum (fromEnum code - fromEnum 'A' + 1))
//                         }
charControl: Prim.ParsecT Byte =
  Prim.parserBind(Char.char(94b), \_ -> Prim.parserBind(Char.upper, \code -> Prim.parserReturn(code -& 65b +& 1b)))

//     charNum         = do{ code <- decimal
//                                   <|> do{ _ <- char 'o'; number 8 octDigit }
//                                   <|> do{ _ <- char 'x'; number 16 hexDigit }
//                         ; if code > 0x10FFFF
//                           then fail "invalid escape sequence"
//                           else return (toEnum (fromInteger code))
//                         }
charNum: Prim.ParsecT Byte =
  let tryOct = Prim.parserBind(Char.char(111b), \_ -> number(8, Char.octDigit)) in
  let tryHex = Prim.parserBind(Char.char(120b), \_ -> number(16, Char.hexDigit)) in
  let tryDecOctHex = Prim.tryOr(decimal, Prim.tryOr(tryOct, tryHex)) in
  Prim.parserBind(tryDecOctHex, \code -> panic("Not implemented because of hex"))

//     charEsc         = choice (map parseEsc escMap)
//                     where
//                       parseEsc (c,code)     = do{ _ <- char c; return code }
charEsc: Prim.ParsecT Byte =
  let parseEsc = \(c, code) -> Prim.parserBind(Char.char(c), \_ -> Prim.parserReturn(code)) in
  Combinator.choice(Array.map(escMap, \(c1, c2) -> parseEsc(c1, c2)))

//     charAscii       = choice (map parseAscii asciiMap)
//                     where
//                       parseAscii (asc,code) = try (do{ _ <- string asc; return code })
charAscii: Prim.ParsecT Byte =
  let parseAscii = \(asc, code) -> Prim.try(Prim.parserBind(Char.string(asc), \_ -> Prim.parserReturn(code))) in
  Combinator.choice(Array.map(asciiMap, parseAscii))


//     -- escape code tables
//     escMap          = zip ("abfnrtv\\\"\'") ("\a\b\f\n\r\t\v\\\"\'")
escMap: Array (Byte, Byte) =
  Array.zip([97b, 98b, 102b, 110b, 114b, 116b, 118b, 92b, 34b, 39b], [7b, 8b, 12b, 10b, 13b, 9b, 11b, 92b, 34b, 39b])
//     asciiMap        = zip (ascii3codes ++ ascii2codes) (ascii3 ++ ascii2)
asciiMap: Array (Array Byte, Byte) =
  Array.zip(Array.concat(ascii3codes, ascii2codes), Array.concat(ascii3, ascii2))

//     ascii2codes     = ["BS","HT","LF","VT","FF","CR","SO","SI","EM",
//                        "FS","GS","RS","US","SP"]
ascii2codes: Array (Array Byte) =
  ["BS","HT","LF","VT","FF","CR","SO","SI","EM","FS","GS","RS","US","SP"]
//     ascii3codes     = ["NUL","SOH","STX","ETX","EOT","ENQ","ACK","BEL",
//                        "DLE","DC1","DC2","DC3","DC4","NAK","SYN","ETB",
//                        "CAN","SUB","ESC","DEL"]
ascii3codes: Array (Array Byte) =
  ["NUL","SOH","STX","ETX","EOT","ENQ","ACK","BEL","DLE","DC1","DC2","DC3","DC4","NAK","SYN","ETB","CAN","SUB","ESC","DEL"]

//     ascii2          = ['\BS','\HT','\LF','\VT','\FF','\CR','\SO','\SI',
//                        '\EM','\FS','\GS','\RS','\US','\SP']
ascii2: Array Byte =
  [8b, 9b, 10b, 11b, 12b, 13b, 14b, 15b, 25b, 28b, 28b, 30b, 31b, 32b]
//     ascii3          = ['\NUL','\SOH','\STX','\ETX','\EOT','\ENQ','\ACK',
//                        '\BEL','\DLE','\DC1','\DC2','\DC3','\DC4','\NAK',
//                        '\SYN','\ETB','\CAN','\SUB','\ESC','\DEL']
ascii3: Array Byte =
  [0b, 1b, 2b, 3b, 4b, 5b, 6b, 7b, 16b, 17b, 18b, 19b, 20b, 21b, 22b, 23b, 24b, 26b, 27b, 127b]


//     -----------------------------------------------------------
//     -- Numbers
//     -----------------------------------------------------------
//     naturalOrFloat  = lexeme (natFloat) <?> "number"
naturalOrFloat(ld: GenLanguageDef): Prim.ParsecT (Either.Either Int Float) =
  Prim.withErr(lexeme(ld, natFloat), "number")

//     float           = lexeme floating   <?> "float"
float(ld: GenLanguageDef): Prim.ParsecT Float =
  Prim.withErr(lexeme(ld, floating), "float")
//     integer         = lexeme int        <?> "integer"
integer(ld: GenLanguageDef): Prim.ParsecT Int =
  Prim.withErr(lexeme(ld, int(ld)), "integer")
//     natural         = lexeme nat        <?> "natural"
natural(ld: GenLanguageDef): Prim.ParsecT Int =
  Prim.withErr(lexeme(ld, nat), "natural")


//     -- floats
//     floating        = do{ n <- decimal
//                         ; fractExponent n
//                         }
floating: Prim.ParsecT Float =
  Prim.parserBind(decimal, \n -> fractExponent(n))


//     natFloat        = do{ _ <- char '0'
//                         ; zeroNumFloat
//                         }
//                       <|> decimalFloat
natFloat: Prim.ParsecT (Either.Either Int Float) =
  Prim.tryOr(Prim.parserBind(Char.char(48b), \_ -> zeroNumFloat), decimalFloat)

//     zeroNumFloat    =  do{ n <- hexadecimal <|> octal
//                          ; return (Left n)
//                          }
//                     <|> decimalFloat
//                     <|> fractFloat (0 :: Integer)
//                     <|> return (Left 0)
zeroNumFloat: Prim.ParsecT (Either.Either Int Float) =
  Prim.tryOr(Prim.parserBind(Prim.tryOr(hexadecimal, octal), \n -> Prim.parserReturn(Either.Left(n))), Prim.tryOr(decimalFloat, Prim.tryOr(fractFloat(0), Prim.parserReturn(Either.Left(0)))))

//     decimalFloat    = do{ n <- decimal
//                         ; option (Left n)
//                                  (fractFloat n)
//                         }
decimalFloat: Prim.ParsecT (Either.Either Int Float) =
  Prim.parserBind(decimal, \n -> Combinator.option(Either.Left(n), fractFloat(n)))

//     fractFloat n    = do{ f <- fractExponent n
//                         ; return (Right f)
//                         }
fractFloat(n: Int): Prim.ParsecT (Either.Either Int Float) =
  Prim.parserBind(fractExponent(n), \f -> Prim.parserReturn(Either.Right(f)))

//     fractExponent n = do{ fract <- fraction
//                         ; expo  <- option "" exponent'
//                         ; readDouble (show n ++ fract ++ expo)
//                         }
//                     <|>
//                       do{ expo <- exponent'
//                         ; readDouble (show n ++ expo)
//                         }
//                       where
//                         readDouble s =
//                           case reads s of
//                             [(x, "")] -> return x
//                             _         -> parserZero
fractExponent(n: Int): Prim.ParsecT Float =
  panic("Not implemented yet")

//     fraction        = do{ _ <- char '.'
//                         ; digits <- many1 digit <?> "fraction"
//                         ; return ('.' : digits)
//                         }
//                       <?> "fraction"

//     exponent'       = do{ _ <- oneOf "eE"
//                         ; sign' <- fmap (:[]) (oneOf "+-") <|> return ""
//                         ; e <- decimal <?> "exponent"
//                         ; return ('e' : sign' ++ show e)
//                         }
//                       <?> "exponent"


//     -- integers and naturals
//     int             = do{ f <- lexeme sign
//                         ; n <- nat
//                         ; return (f n)
//                         }
int(ld: GenLanguageDef): Prim.ParsecT Int =
  Prim.parserBind(lexeme(ld, sign), \f -> Prim.parserBind(nat, \n -> Prim.parserReturn(f(n))))

//     sign            =   (char '-' >> return negate)
//                     <|> (char '+' >> return id)
//                     <|> return id
sign: Prim.ParsecT (Int -> Int) =
  Prim.tryOr(Prim.parserBind(Char.char(45b), \_ -> Prim.parserReturn(\x -> -x)), Prim.tryOr(Prim.parserBind(Char.char(43b), \_ -> Prim.parserReturn(Func.id)), Prim.parserReturn(Func.id)))

//     nat             = zeroNumber <|> decimal
nat: Prim.ParsecT Int =
  Prim.tryOr(zeroNumber, decimal)

//     zeroNumber      = do{ _ <- char '0'
//                         ; hexadecimal <|> octal <|> decimal <|> return 0
//                         }
//                       <?> ""
zeroNumber: Prim.ParsecT Int =
  Prim.withErr(Prim.parserBind(Char.char(48b), \_ -> Prim.tryOr(hexadecimal, Prim.tryOr(octal, Prim.tryOr(decimal, Prim.parserReturn(0))))), "")

//     decimal         = number 10 digit
decimal: Prim.ParsecT Int =
  number(10, Char.digit)
//     hexadecimal     = do{ _ <- oneOf "xX"; number 16 hexDigit }
hexadecimal: Prim.ParsecT Int =
  Prim.parserBind(Char.oneOf([120b, 88b]), \_ -> number(16, Char.hexDigit))
//     octal           = do{ _ <- oneOf "oO"; number 8 octDigit  }
octal: Prim.ParsecT Int =
  Prim.parserBind(Char.oneOf([111b, 79b]), \_ -> number(8, Char.octDigit))

//     number base baseDigit
//         = do{ digits <- many1 baseDigit
//             ; let n = foldl (\x d -> base*x + toInteger (digitToInt d)) 0 digits
//             ; seq n (return n)
//             }
number(base: Int, baseDigit: Prim.ParsecT a): Prim.ParsecT Int =
  // Prim.parserBind(Prim.many1(baseDigit), \digits -> Prim.parserReturn(Array.foldl(digits, 0, \(x, d) -> base*x + toInteger(digitToInt(d)))))
  panic("toInteger needs to be implemented")

//     -----------------------------------------------------------
//     -- Operators & reserved ops
//     -----------------------------------------------------------
//     reservedOp name =
//         lexeme $ try $
//         do{ _ <- string name
//           ; notFollowedBy (opLetter languageDef) <?> ("end of " ++ show name)
//           }
reservedOp(ld: GenLanguageDef, name: Array Byte): Prim.ParsecT () =
  lexeme(ld, Prim.try(Prim.parserBind(Char.string(name), \_ -> Prim.withErr(Combinator.notFollowedBy(opLetter(ld)), "end of .."))))

//     operator =
//         lexeme $ try $
//         do{ name <- oper
//           ; if (isReservedOp name)
//              then unexpected ("reserved operator " ++ show name)
//              else return name
//           }
operator(ld: GenLanguageDef): Prim.ParsecT (Array Byte) =
  lexeme(ld, Prim.try(Prim.parserBind(oper(ld), \name -> if isReservedOp(ld, name) {
    Prim.unexpected("reserved operator")
  } else {
    Prim.parserReturn(name)
  })))

//     oper =
//         do{ c <- (opStart languageDef)
//           ; cs <- many (opLetter languageDef)
//           ; return (c:cs)
//           }
//         <?> "operator"
oper(ld: GenLanguageDef): Prim.ParsecT (Array Byte) =
  Prim.withErr(Prim.parserBind(opStart(ld), \c -> Prim.parserBind(Prim.many(opLetter(ld)), \cs -> Prim.parserReturn(Array.push_front(c, cs)))), "operator")

//     isReservedOp name =
//         isReserved (sort (reservedOpNames languageDef)) name
isReservedOp(ld: GenLanguageDef, name: Array Byte): Bool =
  isReserved(Array.sortBy(String.ordString, reservedOpNames(ld)), name)


//     -----------------------------------------------------------
//     -- Identifiers & Reserved words
//     -----------------------------------------------------------
//     reserved name =
//         lexeme $ try $
//         do{ _ <- caseString name
//           ; notFollowedBy (identLetter languageDef) <?> ("end of " ++ show name)
//           }
reserved(ld: GenLanguageDef, name: Array Byte): Prim.ParsecT () =
  lexeme(ld, Prim.try(Prim.parserBind(caseString(ld, name), \_ -> Prim.withErr(Combinator.notFollowedBy(identLetter(ld)), "end of .."))))

//     caseString name
//         | caseSensitive languageDef  = string name
//         | otherwise               = do{ walk name; return name }
//         where
//           walk []     = return ()
//           walk (c:cs) = do{ _ <- caseChar c <?> msg; walk cs }

//           caseChar c  | isAlpha c  = char (toLower c) <|> char (toUpper c)
//                       | otherwise  = char c

//           msg         = show name
caseString(ld: GenLanguageDef, name: Array Byte): Prim.ParsecT (Array Byte) =
  if caseSensitive(ld) {
    Char.string(name)
  } else {
    Prim.parserBind(caseStringWalk(name, Iter.items(name)), \_ -> Prim.parserReturn(name))
  }

caseStringWalk(name: Array Byte, ccs: Iter.Iter Byte): Prim.ParsecT () =
  match Iter.next(ccs) {
    Option.None -> Prim.parserReturn(()),
    Option.Some(c, cs) -> Prim.parserBind(Prim.withErr(caseStringCaseChar(c), name), \_ -> caseStringWalk(name, cs))
  }

caseStringCaseChar(c: Byte): Prim.ParsecT Byte =
  if String.isAlpha(c) {
    Prim.tryOr(Char.char(String.toLower(c)), Char.char(String.toUpper(c)))
  } else {
    Char.char(c)
  }

//     identifier =
//         lexeme $ try $
//         do{ name <- ident
//           ; if (isReservedName name)
//              then unexpected ("reserved word " ++ show name)
//              else return name
//           }
identifier(ld: GenLanguageDef): Prim.ParsecT (Array Byte) =
  lexeme(ld, Prim.try(Prim.parserBind(ident(ld), \name -> if isReservedName(ld, name) {
    Prim.unexpected("reserved word")
  } else {
    Prim.parserReturn(name)
  })))


//     ident
//         = do{ c <- identStart languageDef
//             ; cs <- many (identLetter languageDef)
//             ; return (c:cs)
//             }
//         <?> "identifier"
ident(ld: GenLanguageDef): Prim.ParsecT (Array Byte) =
  Prim.withErr(Prim.parserBind(identStart(ld), \c -> Prim.parserBind(Prim.many(identLetter(ld)), \cs -> Prim.parserReturn(Array.push_front(c, cs)))), "identifier")

//     isReservedName name
//         = isReserved theReservedNames caseName
//         where
//           caseName      | caseSensitive languageDef  = name
//                         | otherwise               = map toLower name
isReservedName(ld: GenLanguageDef, name: Array Byte): Bool =
  let caseName = if caseSensitive(ld) {
    name
  } else {
    Array.map(name, String.toLower)
  } in
  isReserved(theReservedNames(ld), caseName)


//     isReserved names name
//         = scan names
//         where
//           scan []       = False
//           scan (r:rs)   = case (compare r name) of
//                             LT  -> scan rs
//                             EQ  -> True
//                             GT  -> False
isReserved(names: Array (Array Byte), name: Array Byte): Bool =
  isReservedScan(Iter.items(names), name)

isReservedScan(names: Iter.Iter (Array Byte), name: Array Byte): Bool =
  match Iter.next(names) {
    Option.None -> False,
    Option.Some(r, rs) -> match Ord.compare(String.ordString, r, name) {
      Ord.LT -> isReservedScan(rs, name),
      Ord.EQ -> True,
      Ord.GT -> False
    }
  }

//     theReservedNames
//         | caseSensitive languageDef  = sort reserved
//         | otherwise                  = sort . map (map toLower) $ reserved
//         where
//           reserved = reservedNames languageDef
theReservedNames(ld: GenLanguageDef): Array (Array Byte) =
  let reserved = reservedNames(ld) in
  if caseSensitive(ld) {
    Array.sortBy(String.ordString, reserved)
  } else {
    Array.sortBy(String.ordString, Array.map(reserved, \xs -> Array.map(xs, String.toLower)))
  }



//     -----------------------------------------------------------
//     -- White space & symbols
//     -----------------------------------------------------------
//     symbol name
//         = lexeme (string name)
symbol(ld: GenLanguageDef, name: Array Byte): Prim.ParsecT (Array Byte) =
  lexeme(ld, Char.string(name))

//     lexeme p
//         = do{ x <- p; whiteSpace; return x  }
lexeme(ld: GenLanguageDef, p: Prim.ParsecT a): Prim.ParsecT a =
  Prim.parserBind(p, \x -> Prim.parserBind(whiteSpace(ld), \_ -> Prim.parserReturn(x)))


//     --whiteSpace
//     whiteSpace
//         | noLine && noMulti  = skipMany (simpleSpace <?> "")
//         | noLine             = skipMany (simpleSpace <|> multiLineComment <?> "")
//         | noMulti            = skipMany (simpleSpace <|> oneLineComment <?> "")
//         | otherwise          = skipMany (simpleSpace <|> oneLineComment <|> multiLineComment <?> "")
//         where
//           noLine  = null (commentLine languageDef)
//           noMulti = null (commentStart languageDef)
whiteSpace(ld: GenLanguageDef): Prim.ParsecT () =
  let noLine = Array.is_empty(commentLine(ld)) in
  let noMulti = Array.is_empty(commentStart(ld)) in
  if noLine && noMulti {
    Prim.skipMany(Prim.withErr(simpleSpace, ""))
  } else if noLine {
    Prim.skipMany(Prim.withErr(Prim.tryOr(simpleSpace, multiLineComment(ld)), ""))
  } else if noMulti {
    Prim.skipMany(Prim.withErr(Prim.tryOr(simpleSpace, oneLineComment(ld)), ""))
  } else {
    Prim.skipMany(Prim.withErr(Prim.tryOr(simpleSpace, Prim.tryOr(oneLineComment(ld), multiLineComment(ld))), ""))
  }


//     simpleSpace =
//         skipMany1 (satisfy isSpace)
simpleSpace: Prim.ParsecT () =
  Combinator.skipMany1(Char.satisfy(String.isSpace))

//     oneLineComment =
//         do{ _ <- try (string (commentLine languageDef))
//           ; skipMany (satisfy (/= '\n'))
//           ; return ()
//           }
oneLineComment(languageDef: GenLanguageDef): Prim.ParsecT () =
  Prim.parserBind(Prim.try(Char.string(commentLine(languageDef))), \_ -> Prim.parserBind(Prim.skipMany(Char.satisfy(\x -> !(x =& 10b))), \_ -> Prim.parserReturn(())))

//     multiLineComment =
//         do { _ <- try (string (commentStart languageDef))
//            ; inComment
//            }
multiLineComment(ld: GenLanguageDef): Prim.ParsecT () =
  Prim.parserBind(Prim.try(Char.string(commentStart(ld))), \_ -> inComment(ld))

//     inComment
//         | nestedComments languageDef  = inCommentMulti
//         | otherwise                = inCommentSingle
inComment(ld: GenLanguageDef): Prim.ParsecT () =
  if nestedComments(ld) {
    inCommentMulti(ld)
  } else {
    inCommentSingle(ld)
  }

//     inCommentMulti
//         =   do{ _ <- try (string (commentEnd languageDef)) ; return () }
//         <|> do{ multiLineComment                     ; inCommentMulti }
//         <|> do{ skipMany1 (noneOf startEnd)          ; inCommentMulti }
//         <|> do{ _ <- oneOf startEnd                  ; inCommentMulti }
//         <?> "end of comment"
//         where
//           startEnd   = nub (commentEnd languageDef ++ commentStart languageDef)
inCommentMulti(ld: GenLanguageDef): Prim.ParsecT () =
  let startEnd = Array.nub(Array.concat(commentEnd(ld), commentStart(ld)), \(c1, c2) -> c1 =& c2) in
  Prim.withErr(Prim.tryOr(Prim.parserBind(Prim.try(Char.string(commentEnd(ld))), \_ -> Prim.parserReturn(())),
  Prim.tryOr(Prim.parserBind(multiLineComment(ld), \_ -> inCommentMulti(ld)),
  Prim.tryOr(Prim.parserBind(Combinator.skipMany1(Char.noneOf(startEnd)), \_ -> inCommentMulti(ld)),
  Prim.parserBind(Char.oneOf(startEnd), \_ -> inCommentMulti(ld))))), "end of comment")

//     inCommentSingle
//         =   do{ _ <- try (string (commentEnd languageDef)); return () }
//         <|> do{ skipMany1 (noneOf startEnd)         ; inCommentSingle }
//         <|> do{ _ <- oneOf startEnd                 ; inCommentSingle }
//         <?> "end of comment"
//         where
//           startEnd   = nub (commentEnd languageDef ++ commentStart languageDef)
inCommentSingle(ld: GenLanguageDef): Prim.ParsecT () =
  let startEnd = Array.nub(Array.concat(commentEnd(ld), commentStart(ld)), \(c1, c2) -> c1 =& c2) in
  Prim.withErr(Prim.tryOr(Prim.parserBind(Prim.try(Char.string(commentEnd(ld))), \_ -> Prim.parserReturn(())),
  Prim.tryOr(Prim.parserBind(Combinator.skipMany1(Char.noneOf(startEnd)), \_ -> inCommentSingle(ld)),
  Prim.parserBind(Char.oneOf(startEnd), \_ -> inCommentSingle(ld)))), "end of comment")