//       splitOp (Infix op assoc) (rassoc,lassoc,nassoc,prefix,postfix)
//         = case assoc of
//             AssocNone  -> (rassoc,lassoc,op:nassoc,prefix,postfix)
//             AssocLeft  -> (rassoc,op:lassoc,nassoc,prefix,postfix)
//             AssocRight -> (op:rassoc,lassoc,nassoc,prefix,postfix)

//       splitOp (Prefix op) (rassoc,lassoc,nassoc,prefix,postfix)
//         = (rassoc,lassoc,nassoc,op:prefix,postfix)

//       splitOp (Postfix op) (rassoc,lassoc,nassoc,prefix,postfix)
//         = (rassoc,lassoc,nassoc,prefix,op:postfix)
buildExpressionParser(operators: Array (Array (Operator s u a r)), simpleExpr: Prim.ParsecT a): Prim.ParsecT a =
  Array.foldl(Array.map(operators, Iter.items), simpleExpr, \(term, ops) -> makeParser(term, ops))

makeParser(term: Prim.ParsecT a, ops: Iter.Iter (Operator s u a r)): Prim.ParsecT a =
  let (rassoc, lassoc, nassoc, prefix, postfix) = Iter.foldr(ops, ([],[],[],[],[]), splitOp) in
  let rassocOp = Combinator.choice(rassoc) in
  let lassocOp = Combinator.choice(lassoc) in
  let nassocOp = Combinator.choice(nassoc) in
  let prefixOp = Prim.withErr(Combinator.choice(prefix), "") in
  let postfixOp = Prim.withErr(Combinator.choice(postfix), "") in

  let ambiguous = \(assoc, op) -> Prim.try(Prim.parserBind(op, \_ -> Prim.parserFail(Array.concat(Array.concat("ambiguous use of a ", assoc), " associative operator")))) in
  
  let ambiguousRight = ambiguous("right", rassocOp) in
  let ambiguousLeft = ambiguous("left", lassocOp) in
  let ambiguousNon = ambiguous("non", nassocOp) in

  let postfixP = Prim.tryOr(postfixOp, Prim.parserReturn(Func.id)) in
  let prefixP = Prim.tryOr(prefixOp, Prim.parserReturn(Func.id)) in

  let nassocP = \x -> Prim.parserBind(nassocOp, \f -> Prim.parserBind(termP(term, prefixP, postfixP), \y -> Prim.tryOr(ambiguousRight, Prim.tryOr(ambiguousLeft, Prim.tryOr(ambiguousNon, Prim.parserReturn(f(x, y))))))) in
  
  Prim.parserBind(termP(term, prefixP, postfixP), \x -> Prim.withErr(Prim.tryOr(rassocP(x, term, rassocOp, ambiguousLeft, ambiguousNon, prefixP, postfixP), Prim.tryOr(lassocP(x, term, lassocOp, ambiguousRight, ambiguousNon, prefixP, postfixP), Prim.tryOr(nassocP(x), Prim.parserReturn(x)))), "operator"))

termP(term: Prim.ParsecT a, prefixP: Prim.ParsecT (a -> a), postfixP: Prim.ParsecT (a -> a)): Prim.ParsecT a =
  Prim.parserBind(prefixP, \pre -> Prim.parserBind(term, \x -> Prim.parserBind(postfixP, \post -> Prim.parserReturn(post(pre(x))))))

lassocP(x: a, term: Prim.ParsecT a, lassocOp: Prim.ParsecT ((a, a) -> a), ambiguousRight: Prim.ParsecT a, ambiguousNon: Prim.ParsecT a, prefixP: Prim.ParsecT (a -> a), postfixP: Prim.ParsecT (a -> a)): Prim.ParsecT a =
  Prim.tryOr(Prim.parserBind(lassocOp, \f -> Prim.parserBind(termP(term, prefixP, postfixP), \y -> lassocP1(f(x, y), term, lassocOp, ambiguousRight, ambiguousNon, prefixP, postfixP))), Prim.tryOr(ambiguousRight, ambiguousNon))

lassocP1(x: a, term: Prim.ParsecT a, lassocOp: Prim.ParsecT ((a, a) -> a), ambiguousRight: Prim.ParsecT a, ambiguousNon: Prim.ParsecT a, prefixP: Prim.ParsecT (a -> a), postfixP: Prim.ParsecT (a -> a)): Prim.ParsecT a =
  Prim.tryOr(lassocP(x, term, lassocOp, ambiguousRight, ambiguousNon, prefixP, postfixP), Prim.parserReturn(x))

rassocP(x: a, term: Prim.ParsecT a, rassocOp: Prim.ParsecT ((a, a) -> a), ambiguousLeft: Prim.ParsecT a, ambiguousNon: Prim.ParsecT a, prefixP: Prim.ParsecT (a -> a), postfixP: Prim.ParsecT (a -> a)): Prim.ParsecT a =
  Prim.tryOr(Prim.parserBind(rassocOp, \f -> Prim.parserBind(Prim.parserBind(termP(term, prefixP, postfixP), \z -> rassocP1(z, term, rassocOp, ambiguousLeft, ambiguousNon, prefixP, postfixP)), \y -> Prim.parserReturn(f(x, y)))), Prim.tryOr(ambiguousLeft, ambiguousNon))

rassocP1(x: a, term: Prim.ParsecT a, rassocOp: Prim.ParsecT ((a, a) -> a), ambiguousLeft: Prim.ParsecT a, ambiguousNon: Prim.ParsecT a, prefixP: Prim.ParsecT (a -> a), postfixP: Prim.ParsecT (a -> a)): Prim.ParsecT a =
  Prim.tryOr(rassocP(x, term, rassocOp, ambiguousLeft, ambiguousNon, prefixP, postfixP), Prim.parserReturn(x))

splitOp(a: Operator s u a r, accum: (Array (Prim.ParsecT ((a, a) -> a)), Array (Prim.ParsecT ((a, a) -> a)), Array (Prim.ParsecT ((a, a) -> a)), Array (Prim.ParsecT (a -> a)), Array (Prim.ParsecT (a -> a)))): (Array (Prim.ParsecT ((a, a) -> a)), Array (Prim.ParsecT ((a, a) -> a)), Array (Prim.ParsecT ((a, a) -> a)), Array (Prim.ParsecT (a -> a)), Array (Prim.ParsecT (a -> a))) =
  let (rassoc, lassoc, nassoc, prefix, postfix) = accum in
  match a {
    Infix(op, assoc) -> match assoc {
      AssocNone -> (rassoc, lassoc, Array.push_front(op, nassoc), prefix, postfix),
      AssocLeft -> (rassoc, Array.push_front(op, lassoc), nassoc, prefix, postfix),
      AssocRight -> (Array.push_front(op, rassoc), lassoc, nassoc, prefix, postfix)
    },
    Prefix(op) -> (rassoc, lassoc, nassoc, Array.push_front(op, prefix), postfix),
    Postfix(op) -> (rassoc, lassoc, nassoc, prefix, Array.push_front(op, postfix))
  }