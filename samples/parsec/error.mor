import Core
  expose {
    module Array,
    module Iter,
    module Ord,
    module Option,
    module String
  }

import Pos expose { SourcePos }

proc main(): () = do output(Array.concat("Hello, ", "world!"))

pub type Message {
  pub SysUnExpect(Array Byte),
  pub UnExpect(Array Byte),
  pub Expect(Array Byte),
  pub Message(Array Byte)
}

getEnumIndex(m: Message): Int =
  match m {
    SysUnExpect(_) -> 0,
    UnExpect(_) -> 1,
    Expect(_) -> 2,
    Message(_) -> 3
  }

pub messageString(message: Message): Array Byte =
  match message {
    SysUnExpect(msg) -> msg,
    UnExpect(msg) -> msg,
    Expect(msg) -> msg,
    Message(msg) -> msg
  }

ordMessage: Ord.Ord Message =
  Ord.Ord(\(m1, m2) -> Ord.compare(Ord.ordInts, getEnumIndex(m1), getEnumIndex(m2)))

compareMessages(m1: Message, m2: Message): Ord.Ordering =
  Ord.compare(Ord.ordInts, getEnumIndex(m1), getEnumIndex(m2))

eqMessage(m1: Message, m2: Message): Bool =
  getEnumIndex(m1) = getEnumIndex(m2)

// sortMessages(ms: Array Message): Array Message =
//   sortBy 

pub type ParseError {
  pub ParseError(SourcePos, Array Message)
}

errorPos(e: ParseError): SourcePos =
  let ParseError(pos,_) = e in pos

// -- | Extracts the list of error messages from the parse error

// errorMessages :: ParseError -> [Message]
// errorMessages (ParseError _pos msgs)
//     = sort msgs
pub errorMessages(e: ParseError): Array Message =
  let ParseError(_, msgs) = e in Array.sortBy(ordMessage, msgs)

// errorIsUnknown :: ParseError -> Bool
// errorIsUnknown (ParseError _pos msgs)
//     = null msgs

// -- < Create parse errors
pub errorIsUnknown(e: ParseError): Bool =
  let ParseError(_, msgs) = e in Array.is_empty(msgs)

// newErrorUnknown :: SourcePos -> ParseError
// newErrorUnknown pos
//     = ParseError pos []
pub newErrorUnknown(pos: SourcePos): ParseError =
  ParseError(pos, Array.from_iter(Iter.empty))

// newErrorMessage :: Message -> SourcePos -> ParseError
// newErrorMessage msg pos
//     = ParseError pos [msg]
pub newErrorMessage(msg: Message, pos: SourcePos): ParseError = ParseError(pos, [msg])

// addErrorMessage :: Message -> ParseError -> ParseError
// addErrorMessage msg (ParseError pos msgs)
//     = ParseError pos (msg:msgs)
pub addErrorMessage(msg: Message, e: ParseError): ParseError =
  let ParseError(pos, msgs) = e in ParseError(pos, Array.push_front(msg, msgs))

// setErrorPos :: SourcePos -> ParseError -> ParseError
// setErrorPos pos (ParseError _ msgs)
//     = ParseError pos msgs
setErrorPos(pos: SourcePos, e: ParseError): ParseError =
  let ParseError(_, msgs) = e in ParseError(pos, msgs)

// setErrorMessage :: Message -> ParseError -> ParseError
// setErrorMessage msg (ParseError pos msgs)
//     = ParseError pos (msg : filter (msg /=) msgs)
pub setErrorMessage(msg: Message, e: ParseError): ParseError =
  let ParseError(pos, msgs) = e in ParseError(pos, Array.push_front(msg, Array.from_iter(Iter.filter(Iter.items(msgs), \msg2 -> eqMessage(msg, msg2)))))

// mergeError :: ParseError -> ParseError -> ParseError
// mergeError e1@(ParseError pos1 msgs1) e2@(ParseError pos2 msgs2)
//     -- prefer meaningful errors
//     | null msgs2 && not (null msgs1) = e1
//     | null msgs1 && not (null msgs2) = e2
//     | otherwise
//       -- perfectly we'd compare the consumed token count
//       -- https://github.com/haskell/parsec/issues/175
//     = case compareErrorPos pos1 pos2 of
//         -- select the longest match
//         EQ -> ParseError pos1 (msgs1 ++ msgs2)
//         GT -> e1
//         LT -> e2
pub mergeError(e1: ParseError, e2: ParseError): ParseError =
  let ParseError(pos1, msgs1) = e1 in
  let ParseError(pos2, msgs2) = e2 in
  if Array.is_empty(msgs2) && !(Array.is_empty(msgs1)) {
    e1
  } else if Array.is_empty(msgs1) && !(Array.is_empty(msgs2)) {
    e2
  } else {
    match compareErrorPos(pos1, pos2) {
      Ord.EQ -> ParseError(pos1, Array.concat(msgs1, msgs2)),
      Ord.GT -> e1,
      Ord.LT -> e2
    }
  }

// compareErrorPos :: SourcePos -> SourcePos -> Ordering
// compareErrorPos x y = Mon.mappend (compare (sourceLine x) (sourceLine y)) (compare (sourceColumn x) (sourceColumn y))
compareErrorPos(x: Pos.SourcePos, y: Pos.SourcePos): Ord.Ordering =
  let Pos.SourcePos(_,lineX,colX) = x in
  let Pos.SourcePos(_,lineY,colY) = y in
  match Ord.compare(Ord.ordInts, lineX, lineY) {
    Ord.EQ -> Ord.compare(Ord.ordInts, colX, colY),
    Ord.GT -> Ord.GT,
    Ord.LT -> Ord.LT
  }

pub showParseError(err: ParseError): Array Byte =
  Pos.showPos(errorPos(err)) |> Array.concat(":") |> Array.concat(showErrorMessages("or", "unknown parse error", "expecting", "unexpected", "end of input", errorMessages(err))) |> Array.concat("\n")
