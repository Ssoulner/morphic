import Core
  expose {
    module Array,
    module Iter,
    module Ord,
    module Option,
    module String
  }

import Pos expose { SourcePos }

proc main(): () = do output(Array.concat("Hello, ", "world!"))

pub type Message {
  pub SysUnExpect(Array Byte),
  pub UnExpect(Array Byte),
  pub Expect(Array Byte),
  pub Message(Array Byte)
}

getEnumIndex(m: Message): Int =
  match m {
    SysUnExpect(_) -> 0,
    UnExpect(_) -> 1,
    Expect(_) -> 2,
    Message(_) -> 3
  }

pub messageString(message: Message): Array Byte =
  match message {
    SysUnExpect(msg) -> msg,
    UnExpect(msg) -> msg,
    Expect(msg) -> msg,
    Message(msg) -> msg
  }

ordMessage: Ord.ORD Message =
  Ord.ORD(\(m1, m2) -> Ord.compare(Ord.ordInts, getEnumIndex(m1), getEnumIndex(m2)))

compareMessages(m1: Message, m2: Message): Ord.Order =
  Ord.compare(Ord.ordInts, getEnumIndex(m1), getEnumIndex(m2))

eqMessage(m1: Message, m2: Message): Bool =
  getEnumIndex(m1) = getEnumIndex(m2)

pub type ParseError {
  pub ParseError(SourcePos, Array Message)
}

errorPos(e: ParseError): SourcePos =
  let ParseError(pos,_) = e in pos

// -- | Extracts the list of error messages from the parse error

pub errorMessages(e: ParseError): Array Message =
  let ParseError(_, msgs) = e in Array.sortBy(ordMessage, msgs)

// -- < Create parse errors
pub errorIsUnknown(e: ParseError): Bool =
  let ParseError(_, msgs) = e in Array.is_empty(msgs)

pub newErrorUnknown(pos: SourcePos): ParseError =
  ParseError(pos, Array.from_iter(Iter.empty))

pub newErrorMessage(msg: Message, pos: SourcePos): ParseError = ParseError(pos, [msg])

pub addErrorMessage(msg: Message, e: ParseError): ParseError =
  let ParseError(pos, msgs) = e in ParseError(pos, Array.push_front(msg, msgs))

setErrorPos(pos: SourcePos, e: ParseError): ParseError =
  let ParseError(_, msgs) = e in ParseError(pos, msgs)

pub setErrorMessage(msg: Message, e: ParseError): ParseError =
  let ParseError(pos, msgs) = e in ParseError(pos, Array.push_front(msg, Array.from_iter(Iter.filter(Iter.items(msgs), \msg2 -> eqMessage(msg, msg2)))))

pub mergeError(e1: ParseError, e2: ParseError): ParseError =
  let ParseError(pos1, msgs1) = e1 in
  let ParseError(pos2, msgs2) = e2 in
  if Array.is_empty(msgs2) && !(Array.is_empty(msgs1)) {
    e1
  } else if Array.is_empty(msgs1) && !(Array.is_empty(msgs2)) {
    e2
  } else {
    match compareErrorPos(pos1, pos2) {
      Ord.Equal -> ParseError(pos1, Array.concat(msgs1, msgs2)),
      Ord.GThan -> e1,
      Ord.LThan -> e2
    }
  }

compareErrorPos(x: Pos.SourcePos, y: Pos.SourcePos): Ord.Order =
  let Pos.SourcePos(_,lineX,colX) = x in
  let Pos.SourcePos(_,lineY,colY) = y in
  match Ord.compare(Ord.ordInts, lineX, lineY) {
    Ord.Equal -> Ord.compare(Ord.ordInts, colX, colY),
    Ord.GThan -> Ord.GThan,
    Ord.LThan -> Ord.LThan
  }

pub showParseError(err: ParseError): Array Byte =
  Pos.showPos(errorPos(err)) |> Array.concat(":") |> Array.concat(showErrorMessages("or", "unknown parse error", "expecting", "unexpected", "end of input", errorMessages(err))) |> Array.concat("\n")

showErrorMessages(msgOr: Array Byte, msgUnknown: Array Byte, msgExpecting: Array Byte, msgUnExpected: Array Byte, msgEndOfInput: Array Byte, msgs: Array Message): Array Byte =
  if Array.is_empty(msgs) {
    msgUnknown
  } else {
    let (sysUnExpect, msgs1) = Array.span(msgs, \msg -> eqMessage(msg, SysUnExpect(""))) in
    let (unExpect, msgs2) = Array.span(msgs1, \msg -> eqMessage(msg, UnExpect(""))) in
    let (expect, messages) = Array.span(msgs2, \msg -> eqMessage(msg, Expect(""))) in
    let showExpect = showMany(msgOr, msgExpecting, expect) in
    let showUnExpect = showMany(msgOr, msgUnExpected, unExpect) in
    let showSysUnExpect = if !(Array.is_empty(unExpect)) {
      ""
    } else {
      match Iter.next(Iter.items(sysUnExpect)) {
        Option.None -> "",
        Option.Some(msg, rest) -> if Array.is_empty(messageString(msg)) {
          msgUnExpected |> Array.concat(" ") |> Array.concat(msgEndOfInput)
        } else {
          msgUnExpected |> Array.concat(" ") |> Array.concat(messageString(msg))
        }
      }
    } in
    Array.foldl(Array.map(clean([showSysUnExpect, showUnExpect, showExpect, showMessages(msgOr, messages)]), \m -> Array.concat("\n", m)), "", Array.concat)
  }

showMessages(msgOr: Array Byte, msgs: Array Message): Array Byte =
  showMany(msgOr, "", msgs)

showMany(msgOr: Array Byte, pre: Array Byte, msgs3: Array Message): Array Byte =
  let ms = clean(Array.map(msgs3, messageString)) in
  if Array.is_empty(ms) {
    ""
  } else if Array.is_empty(pre) {
    commasOr(msgOr, ms)
  } else {
    pre |> Array.concat(" ") |> Array.concat(commasOr(msgOr, ms))
  }

commasOr(msgOr: Array Byte, ms1: Array (Array Byte)): Array Byte =
  match Iter.next(Iter.items(ms1)) {
    Option.None -> "",
    Option.Some(m, ms) -> match Iter.next(ms) {
      Option.None -> m,
      Option.Some(_,_) -> commaSep(Option.unwrap(Array.init(Array.from_iter(ms)))) |> Array.concat(" ") |> Array.concat(msgOr) |> Array.concat(" ") |> Array.concat(Option.unwrap(Array.last(Array.from_iter(ms))))
    }
  }

commaSep(msgs: Array (Array Byte)): Array Byte =
  separate(", ", clean(msgs))

separate(sep: Array Byte, ms1: Array (Array Byte)): Array Byte =
  match Iter.next(Iter.items(ms1)) {
    Option.None -> "",
    Option.Some(m, ms) -> match Iter.next(ms) {
      Option.None -> m,
      Option.Some(_,_) -> m |> Array.concat(sep) |> Array.concat(separate(sep, Array.from_iter(ms)))
    }
  }

clean(msgs: Array (Array Byte)): Array (Array Byte) =
  Array.nub(Array.from_iter(Iter.filter(Iter.items(msgs), \msg -> !Array.is_empty(msg))), String.equal)