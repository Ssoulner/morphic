import Iter
import Option

pub type Order {
  pub Equal,
  pub GThan,
  pub LThan
}

pub type ORD a {
  pub ORD((a, a) -> Order)
}

pub compare(ord: ORD a, x1: a, x2: a): Order =
  let ORD(f) = ord in f(x1, x2)

pub ordInts: ORD Int =
  ORD(\(x1, x2) ->
    if x1 = x2 {
      Equal
    } else if x1 > x2 {
      GThan
    } else {
      LThan
    })

pub ordByte: ORD Byte =
  ORD(\(x1, x2) ->
    if x1 =& x2 {
      Equal
    } else if x1 >& x2 {
      GThan
    } else {
      LThan
    })