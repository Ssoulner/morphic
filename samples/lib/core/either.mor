import Option
import Array
import Iter

pub type BadGood a b {
  pub Bad(a),
  pub Good(b)
}

pub either(ifLeft: a -> c, ifRight: b -> c, e: BadGood a b): c =
  match e {
    Bad(a) -> ifLeft(a),
    Good(b) -> ifRight(b)
  }

pub lefts(es: Array (BadGood a b)): Array a = leftsI(Iter.items(es))

leftsI(es: Iter.Iter (BadGood a b)): Array a =
  match Iter.next(es) {
    Option.None -> [],
    Option.Some(e, es1) -> match e {
      Bad(a) -> Array.push_front(a, leftsI(es1)),
      Good(_) -> leftsI(es1)
    }
  }

pub rights(es: Array (BadGood a b)): Array b = rightsI(Iter.items(es))

rightsI(es: Iter.Iter (BadGood a b)): Array b =
  match Iter.next(es) {
    Option.None -> [],
    Option.Some(e, es1) -> match e {
      Bad(_) -> rightsI(es1),
      Good(b) -> Array.push_front(b, rightsI(es1))
    }
  }

pub is_left(e: BadGood a b): Bool =
  match e {
    Bad(_) -> True,
    Good(_) -> False
  }

pub is_right(e: BadGood a b): Bool =
  match e {
    Bad(_) -> False,
    Good(_) -> True
  }

pub from_left(default: a, e: BadGood a b): a =
  match e {
    Bad(a) -> a,
    Good(_) -> default
  }

pub from_right(default: b, e: BadGood a b): b =
  match e {
    Bad(_) -> default,
    Good(b) -> b
  }

pub partition_eithers(es: Array (BadGood a b)): (Array a, Array b) =
  partition_eithersI(Iter.items(es), [], [])

partition_eithersI(es: Iter.Iter (BadGood a b), ls: Array a, rs: Array b): (Array a, Array b) =
  match Iter.next(es) {
    Option.None -> (ls, rs),
    Option.Some(e, es1) ->
      match e {
        Bad(l) -> partition_eithersI(es1, Array.push_front(l, ls), rs),
        Good(r) -> partition_eithersI(es1, ls, Array.push_front(r, rs))
      }
  }