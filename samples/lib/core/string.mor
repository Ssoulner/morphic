    80b -> 112b,
    81b -> 113b,
    82b -> 114b,
    83b -> 115b,
    84b -> 116b,
    85b -> 117b,
    86b -> 118b,
    87b -> 119b,
    88b -> 120b,
    89b -> 121b,
    90b -> 122b,
    _ -> b
  }


pub toUpper(b: Byte): Byte =
  match b {
    97b -> 65b,
    98b -> 66b,
    99b -> 67b,
    100b -> 68b,
    101b -> 69b,
    102b -> 70b,
    103b -> 71b,
